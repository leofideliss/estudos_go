package handler


func RegisterRoutes(){

}

func (h *ProductHandler) RegisterRoutes(mux *http.ServeMux) {
	mux.Handle("GET /products", chain(h.List, middleware.Auth))
	mux.Handle("POST /products", chain(h.Create, middleware.Auth))
	mux.Handle("GET /products/{id}", chain(h.GetByID, middleware.Auth))
}